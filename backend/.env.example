PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/hackmatch?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_change_in_production
CLIENT_URL=http://localhost:5173
ADMIN_EMAIL=superadmin@hackmatch.com
ADMIN_PASSWORD=Admin@123
NODE_ENV=development

# Cloudinary Configuration for Profile Picture Uploads
CLOUDINARY_CLOUD_NAME=demo
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Vercel Cron Security Secret (Header Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=your_production_cron_secret_32_chars_min

# External Hackathon Source Flags (curated feed is enabled by default)
HACKATHON_SOURCE_CURATED_ENABLED=true
HACKATHON_SOURCE_UNSTOP_ENABLED=false
HACKATHON_SOURCE_DEVPOST_ENABLED=false
HACKATHON_SOURCE_MLH_ENABLED=false

{
  "name": "hackmatch-backend",
  "version": "1.0.0",
  "description": "HackMatch - Multi-College Hackathon Team & Skill Matching Platform Backend",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node src/utils/seed.js",
    "seed:demo": "node src/utils/seed.js",
    "seed:admin": "node src/utils/seedAdmin.js",
    "sync:hackathons": "node src/scripts/syncHackathons.js",
    "test": "node tests/test_isolation.js && node tests/test_hackathon_sync.js && node tests/test_search_isolation.js",
    "test:isolation": "node tests/test_isolation.js",
    "test:sync": "node tests/test_hackathon_sync.js",
    "test:search": "node tests/test_search_isolation.js",
    "test:security": "node tests/test_security.js"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^4.21.2",
    "express-validator": "^7.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.13.0"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.1.4",
    "nodemon": "^3.1.9"
  }
}
